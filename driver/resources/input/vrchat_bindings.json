          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/action_menu/in/grab"
            }
          }
        },
        {
          "path": "/user/hand/right/input/trigger",
          "mode": "button",
          "parameters": {
            "click_activate_threshold": "0.7",
            "click_deactivate_threshold": "0.55"
          },
          "inputs": {
            "click": {
              "output": "/actions/action_menu/in/select"
            }
          }
        },
        {
          "path": "/user/hand/right/input/grip",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/action_menu/in/grab"
            }
          }
        }
      ],
      "poses": []
    }
  }
}
