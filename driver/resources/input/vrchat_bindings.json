          }
        },
        {
          "path": "/user/hand/left/input/grip",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/menu/in/drag"
            }
          }
        },
        {
          "path": "/user/hand/right/input/trigger",
          "mode": "button",
          "parameters": {
            "click_activate_threshold": "0.7",
            "click_deactivate_threshold": "0.55"
          },
          "inputs": {
            "click": {
              "output": "/actions/menu/in/confirm"
            }
          }
        },
        {
          "path": "/user/hand/right/input/grip",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/menu/in/drag"
            }
          }
        }
      ],
      "poses": []
